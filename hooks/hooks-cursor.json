{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/skills/handoff/scripts/hooks/session-start.js\"",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/skills/handoff/scripts/hooks/before-submit.js\"",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/skills/handoff/scripts/hooks/stop.js\"",
        "timeout": 10
      }
    ]
  }
}
